      "budget_tokens": 120000,
      "reserve_tokens": 80000,
      "expected_demand_tokens": 20000,
      "will_lend": true,
      "tools": [
        "repo.read",
        "sql.read"
      ]
    },
    {
      "id": "writer-03",
